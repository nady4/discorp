# ─── DisCorp environment configuration ─────────────────────────────────
# Copy this file to `.env` and fill in your values. Never commit .env.

# ─── Application ───────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ─── Discord ───────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=
# Comma-separated user IDs allowed to use /config (admin commands).
# Leave empty to fall back to "Manage Guild" permission.
ADMIN_USER_IDS=

# ─── Databases ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://discorp:discorp@localhost:5432/discorp
REDIS_URL=redis://localhost:6379
# Optional Postgres/Redis passwords for Docker Compose. When REDIS_PASSWORD
# is set, point REDIS_URL at it: redis://:yourpassword@redis:6379 (in Docker)
# or redis://:yourpassword@localhost:6379 (locally).
# POSTGRES_PASSWORD=discorp
# REDIS_PASSWORD=

# ─── AI Provider (BYOK) ────────────────────────────────────────────────
# Provider: "openai" | "anthropic" | "gemini" | "ollama"
#   openai  → works with OpenAI, DeepSeek, OpenRouter, and any OpenAI-
#             compatible gateway. Set AI_BASE_URL to the provider endpoint
#             (e.g. https://opencode.ai/zen/go/v1) and AI_API_KEY to your key.
#   ollama  → local models, no key required. AI_BASE_URL defaults to
#             http://host.docker.internal:11434/v1
#   anthropic → Anthropic Messages API (AI_API_KEY required)
#   gemini  → Google Gemini API (AI_API_KEY required)
AI_PROVIDER=openai
AI_API_KEY=
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_MODEL=deepseek-v4-flash
# Optional per-request overrides
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4096

# ─── Embeddings (long-term memory) ─────────────────────────────────────
# Embedding provider + model. If left blank, falls back to the chat provider.
#   ollama → ollama  + any local model (e.g. nomic-embed-text)
#   openai → openai  + text-embedding-3-small
#   gemini → gemini  + text-embedding-004
# NOTE: AI_EMBEDDING_DIM must match the vector column dimension in the
# PostgreSQL migration (default 1024). Changing it requires a new migration.
AI_EMBEDDING_PROVIDER=
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIM=1024

# ─── Organization defaults ─────────────────────────────────────────────
# New guilds start with this mode: lightweight | standard | autonomous
DEFAULT_GUILD_MODE=standard
# Default monthly budget in USD per guild (safety cap on AI spend)
DEFAULT_MONTHLY_BUDGET=50
# Default max agent executions per guild per day
DEFAULT_MAX_EXECUTIONS_PER_DAY=100
# Max tokens per single agent execution (safety cap)
MAX_TOKENS_PER_EXECUTION=16384
# Fallback price per 1M tokens (USD) for unknown models in cost estimates
FALLBACK_COST_PER_1M_INPUT=1.00
FALLBACK_COST_PER_1M_OUTPUT=3.00

# ─── Agent configuration ───────────────────────────────────────────────
# Directory containing agent.json definitions (builtin + custom).
# In Docker, mount a volume here to persist custom agents.
AGENTS_DIR=./agents/definitions
# Sandbox root for the filesystem tool. Agents can only read/write here.
WORKSPACE_DIR=./data/workspace

# ─── Optional tool credentials ─────────────────────────────────────────
# GitHub token for the github agent tool (repo access). Leave empty to disable.
GITHUB_TOKEN=

# ─── Optional integration credentials (v0.3 tools) ─────────────────────
# Linear (linear_issue_create)
LINEAR_API_KEY=
# Jira (jira_issue_create)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
# Notion (notion_page_create)
NOTION_API_KEY=
NOTION_DATABASE_ID=
# Email (email_send) — plain SMTP, STARTTLS not required
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Slack (slack_message) — app bot token + channel id
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# ─── Ensemble + server / plugins ───────────────────────────────────────
# Optional second model for ensemble reviews (e.g. deepseek-v4-pro)
AI_ENSEMBLE_MODEL=
# Plugin directory (v1.0 plugin system)
PLUGINS_DIR=./plugins
# Web dashboard / orchestration API
SERVER_PORT=8080
SERVER_BIND=0.0.0.0
